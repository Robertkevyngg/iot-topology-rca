# Copy to .env for local runs: cp .env.example .env

# Redis
REDIS_URL=redis://localhost:6379/0

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=iot_topo_local_dev

# MQTT Broker
MQTT_HOST=localhost
MQTT_PORT=1883

# Ingester & RCA tuning
HEARTBEAT_TTL_SECONDS=8
EXPIRY_SWEEP_INTERVAL_SECONDS=1.0
RCA_INTERVAL_SECONDS=1.5
GATEWAY_COVERAGE_THRESHOLD=0.75
PASSIVE_PANEL_COVERAGE_THRESHOLD=0.85

# Simulator
SIMULATOR_INTERVAL_SECONDS=2.0
API_HOST=0.0.0.0
API_PORT=8000
